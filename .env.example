Gemini_key_1=your_gemini_api_key_1
Gemini_key_2=your_gemini_api_key_2
Gemini_key_3=your_gemini_api_key_3

ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Voz alternativa para la escena hook (opcional). Si no se define, se usa ELEVENLABS_VOICE_ID.
ELEVENLABS_HOOK_VOICE_ID=your_hook_voice_id
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Motor TTS: auto = ElevenLabs (si hay key) -> edge-tts -> gTTS. Opciones: elevenlabs | edge | gtts
TTS_ENGINE=auto
TTS_WORKERS=6
# Voces de edge-tts (Microsoft neural; mucho más rápido que gTTS)
EDGE_TTS_VOICE=es-MX-DaliaNeural
EDGE_TTS_HOOK_VOICE=es-MX-JorgeNeural

# Marca por defecto (el editor web puede sobrescribirlas por video)
BRAND_NAME=CerebraFX
BRAND_TAGLINE=Aprende mates con visuales increíbles
BRAND_COLOR=#6c63ff
BRAND_CHANNEL=@cerebrafx
BRAND_SUBSCRIBE_TEXT=Suscríbete

# Pantalla de cierre (segundos). No lleva narración.
END_SCREEN=4.0
